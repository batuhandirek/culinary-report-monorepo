  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "clean": "rm -rf ./dist && rm -rf node_modules",
    "clean:build": "rm -rf ./dist",
    "build": "rm -f dist/tsconfig.tsbuildinfo && NODE_OPTIONS='--max-old-space-size=8192' nest build && tsc-alias",
    "build:watch": "NODE_OPTIONS=--max-old-space-size=4096 concurrently --kill-others --kill-others-on-fail --names 'nest,tsc-alias' -c 'green,cyan' 'nest build --watch --preserveWatchOutput' 'tsc-alias --watch'",
    "start": "nest start",
    "dev": "rm -f dist/tsconfig.tsbuildinfo && NODE_ENV=development NODE_OPTIONS='--max-old-space-size=4096' nest build && tsc-alias &&NODE_ENV=development NODE_OPTIONS='--max-old-space-size=4096' concurrently --kill-others --kill-others-on-fail --names 'tsc-alias,nest' -c 'cyan,green' 'tsc-alias --watch' 'nest start --watch --preserveWatchOutput'",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=4096' jest",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=8192' jest -c jest.integration.config.ts --runInBand",
    "migration:up:prod": "NODE_ENV=production npx mikro-orm migration:up",
    "migration:fresh:prod": "NODE_ENV=production npx mikro-orm migration:fresh",
    "migration:create:dev": "NODE_ENV=development npx mikro-orm migration:create",
    "migration:up:dev": "NODE_ENV=development npx mikro-orm migration:up",
    "migration:down:dev": "NODE_ENV=development npx mikro-orm migration:down",
    "migration:list:dev": "NODE_ENV=development npx mikro-orm migration:list",
    "migration:check:dev": "NODE_ENV=development npx mikro-orm migration:check",
    "migration:pending:dev": "NODE_ENV=development npx mikro-orm migration:pending",
    "migration:fresh:dev": "NODE_ENV=development npx mikro-orm migration:fresh",
    "migration:up:test": "NODE_ENV=test npx mikro-orm migration:up",
    "typia:setup": "npx ts-patch install -s && npx typia patch && npm run clean:build && npm run build"
  },
