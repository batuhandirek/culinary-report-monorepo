NODE_ENV=development
PORT=3015
LOG_LEVEL=debug
DO_NOT_TRACK=1
TURBO_TELEMETRY_DISABLED=1
ROLLUP_USE_WASM=1

# Database: docker/docker-compose.yml
DB_HOST=localhost
DB_PORT=5441
DB_NAME=culinary_report
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_SSL=false

PUBLIC_API_INTERNAL_URL=http://localhost:3015/api
PUBLIC_API_URL=http://localhost:3015/api
PUBLIC_APP_URL=http://localhost:5011
PUBLIC_WS_URL=ws://localhost:3015

# Auth
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRES_IN_MINUTES=45
REFRESH_TOKEN_EXPIRES_IN_DAYS=365
REFRESH_TOKEN_EXPIRES_IN_DAYS_ON_MOBILE=365
VERIFICATION_TOKEN_EXPIRES_IN_MINUTES=1200
FORGOT_PASSWORD_TOKEN_EXPIRES_IN_MINUTES=20
# Every verification code is this one while OTP is disabled
VERIFICATION_DEFAULT_CODE=111111
OTP_IS_DISABLED=true
OTP_IS_VERBOSE=true

# Email (Brevo)
EMAIL_IS_DISABLED=true
EMAIL_IS_VERBOSE=true
EMAIL_SENDER_EMAIL=hello@culinaryreport.com
EMAIL_SENDER_NAME=Culinary Report
BREVO_API_KEY=change-me

# SMS (Verimor)
SMS_IS_DISABLED=true
VERIMOR_USERNAME=change-me
VERIMOR_PASSWORD=change-me
VERIMOR_API_KEY=change-me

# Telegram (admin alerts)
TELEGRAM_IS_DISABLED=true
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_CHAT_ID=change-me

# Images (ImageKit)
IMAGE_KIT_FOLDER_PREFIX=dev
IMAGE_KIT_URL=https://ik.imagekit.io/change-me
IMAGE_KIT_PUBLIC_KEY=change-me
IMAGE_KIT_PRIVATE_KEY=change-me

# Object storage (S3 compatible)
S3_REGION=auto
S3_ENDPOINT=https://change-me
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# Apify (all scraping)
APIFY_TOKEN=change-me

# LLM
# One key per OpenAI account, comma-separated. Calls rotate between them; an account out of
# credits (or with a rejected key) is left out of that model for OPENAI_BLOCK_HOURS
OPENAI_API_KEYS=change-me,change-me-too
OPENAI_ROTATE_AFTER_REQUESTS=20
OPENAI_BLOCK_HOURS=24
ANTHROPIC_API_KEY=change-me
POSTHOG_LLM_EXPORT_IS_ENABLED=false
POSTHOG_API_KEY=change-me
POSTHOG_HOST=https://eu.i.posthog.com
REASONING_SUMMARY_IS_ENABLED=true
IS_LLM_VERBOSE=true

# Tracing: start jaeger from docker-compose and set to true
OTEL_IS_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
TURNSTILE_ENFORCE=false

# Integration journeys against this server (npm run backend:test:integration:local)
INTEGRATION_ADMIN_EMAIL=
INTEGRATION_ADMIN_PASSWORD=
